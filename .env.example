# =============================================================================
# RAKSHA NET AI — Environment configuration template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
RAKSHA_ENVIRONMENT=development          # development | test | staging | production
RAKSHA_DEBUG=true
RAKSHA_PROJECT_NAME="RAKSHA NET AI"
RAKSHA_API_V1_PREFIX=/api/v1
RAKSHA_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
RAKSHA_LOG_FORMAT=json                  # json | console

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=raksha
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=raksha_net_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* values above.
# RAKSHA_DATABASE_URL=postgresql+psycopg://raksha:change_me@localhost:5432/raksha_net_ai

# Database used by the automated test suite. It is dropped/recreated by tests.
RAKSHA_TEST_DATABASE_URL=postgresql+psycopg://raksha:change_me_in_local_env@localhost:5432/raksha_net_ai_test

# -----------------------------------------------------------------------------
# Redis (caching, rate limiting, future task queue)
# -----------------------------------------------------------------------------
RAKSHA_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RAKSHA_SECRET_KEY=generate_a_unique_64_byte_secret_before_running
RAKSHA_JWT_ALGORITHM=HS256
RAKSHA_ACCESS_TOKEN_EXPIRE_MINUTES=30
RAKSHA_REFRESH_TOKEN_EXPIRE_DAYS=14
RAKSHA_PASSWORD_MIN_LENGTH=12
RAKSHA_BCRYPT_ROUNDS=12

# Encrypts contact numbers and MFA secrets at rest. Keep it SEPARATE from
# RAKSHA_SECRET_KEY: rotating the signing secret must not orphan stored data.
# Required outside development; in development one is derived from the secret.
# Generate with:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# To rotate, list the new key first and keep the old one: NEW,OLD (see the runbook).
# RAKSHA_ENCRYPTION_KEY=

# Account lockout: failures before a lock, and the first lock's length. Each
# further failure doubles it, capped at 24 hours.
RAKSHA_ACCOUNT_LOCKOUT_THRESHOLD=5
RAKSHA_ACCOUNT_LOCKOUT_MINUTES=15

# TOTP MFA. When true, every non-citizen account must enrol before using the
# API. Must be true in staging/production (the app will not start otherwise).
RAKSHA_MFA_REQUIRED_FOR_OPERATIONAL=false
RAKSHA_MFA_ISSUER=RAKSHA NET AI

# Comma-separated list of browser origins allowed to call the API.
RAKSHA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting (requests per window, per client identity)
RAKSHA_RATE_LIMIT_ENABLED=true
RAKSHA_RATE_LIMIT_DEFAULT_PER_MINUTE=120
RAKSHA_RATE_LIMIT_AUTH_PER_MINUTE=10
RAKSHA_RATE_LIMIT_REPORT_PER_MINUTE=12

# -----------------------------------------------------------------------------
# Media / uploads
# -----------------------------------------------------------------------------
RAKSHA_MEDIA_STORAGE_BACKEND=local      # local | s3 (s3 planned for Phase 18)
RAKSHA_MEDIA_STORAGE_PATH=./storage/media
RAKSHA_MEDIA_MAX_BYTES=10485760         # 10 MiB
RAKSHA_MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# Malware scanning via a ClamAV daemon (clamd). Unset: uploads are stored as
# UNSCANNED, which is recorded on the file and is not the same as clean.
# RAKSHA_CLAMAV_HOST=clamav
# RAKSHA_CLAMAV_PORT=3310
# RAKSHA_CLAMAV_TIMEOUT_SECONDS=10
# true: refuse uploads while the scanner is unreachable (default: keep, as UNSCANNED).
# RAKSHA_CLAMAV_REQUIRED=false

# -----------------------------------------------------------------------------
# Geospatial
# -----------------------------------------------------------------------------
RAKSHA_GEO_SRID=4326
RAKSHA_GEO_MAX_SEARCH_RADIUS_KM=50
# Rough bounding box used to reject obviously bogus coordinates (default: India).
RAKSHA_GEO_BBOX_MIN_LAT=6.0
RAKSHA_GEO_BBOX_MAX_LAT=37.5
RAKSHA_GEO_BBOX_MIN_LON=68.0
RAKSHA_GEO_BBOX_MAX_LON=97.5

# -----------------------------------------------------------------------------
# AI services (Phase 6+ — not used by V1)
# -----------------------------------------------------------------------------
RAKSHA_AI_ENABLED=false
# RAKSHA_AI_PROVIDER=anthropic
# RAKSHA_AI_API_KEY=set_via_secret_manager_never_in_git
# RAKSHA_AI_MODEL=
# RAKSHA_AI_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Frontend (Next.js — these are build-time public values)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=13.0827
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LON=80.2707
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=11
