# =============================================================================
# RAKSHA NET AI — Environment configuration template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
RAKSHA_ENVIRONMENT=development          # development | test | staging | production
RAKSHA_DEBUG=true
RAKSHA_PROJECT_NAME="RAKSHA NET AI"
RAKSHA_API_V1_PREFIX=/api/v1
RAKSHA_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
RAKSHA_LOG_FORMAT=json                  # json | console

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_USER=raksha
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=raksha_net_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* values above.
# A host-supplied postgres:// or postgresql:// URL is accepted and rewritten to the
# installed psycopg 3 driver (postgresql+psycopg://).
# RAKSHA_DATABASE_URL=postgresql+psycopg://raksha:change_me@localhost:5432/raksha_net_ai

# Database used by the automated test suite. It is dropped/recreated by tests.
RAKSHA_TEST_DATABASE_URL=postgresql+psycopg://raksha:change_me_in_local_env@localhost:5432/raksha_net_ai_test

# -----------------------------------------------------------------------------
# Redis (caching, rate limiting, future task queue)
# -----------------------------------------------------------------------------
RAKSHA_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RAKSHA_SECRET_KEY=generate_a_unique_64_byte_secret_before_running
RAKSHA_JWT_ALGORITHM=HS256
RAKSHA_ACCESS_TOKEN_EXPIRE_MINUTES=30
RAKSHA_REFRESH_TOKEN_EXPIRE_DAYS=14
RAKSHA_PASSWORD_MIN_LENGTH=12
RAKSHA_BCRYPT_ROUNDS=12

# Encrypts contact numbers and MFA secrets at rest. Keep it SEPARATE from
# RAKSHA_SECRET_KEY: rotating the signing secret must not orphan stored data.
# Required outside development; in development one is derived from the secret.
# Generate with:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# To rotate, list the new key first and keep the old one: NEW,OLD (see the runbook).
# RAKSHA_ENCRYPTION_KEY=

# Account lockout: failures before a lock, and the first lock's length. Each
# further failure doubles it, capped at 24 hours.
RAKSHA_ACCOUNT_LOCKOUT_THRESHOLD=5
RAKSHA_ACCOUNT_LOCKOUT_MINUTES=15

# TOTP MFA. When true, every non-citizen account must enrol before using the
# API. Must be true in staging/production (the app will not start otherwise).
RAKSHA_MFA_REQUIRED_FOR_OPERATIONAL=false
RAKSHA_MFA_ISSUER=RAKSHA NET AI

# Comma-separated list of browser origins allowed to call the API.
RAKSHA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate limiting (requests per window, per client identity)
RAKSHA_RATE_LIMIT_ENABLED=true
# memory: counters per process (development, tests, a single process).
# redis:  counters shared through RAKSHA_REDIS_URL, so the limit holds across
#         several API processes. Use redis for any multi-process deployment.
RAKSHA_RATE_LIMIT_BACKEND=memory
RAKSHA_RATE_LIMIT_DEFAULT_PER_MINUTE=120
RAKSHA_RATE_LIMIT_AUTH_PER_MINUTE=10
RAKSHA_RATE_LIMIT_REPORT_PER_MINUTE=12
# Proxies in front of the API that append to X-Forwarded-For (1 behind Render's proxy).
# 0 = use the connecting address. Never more than the proxies every request passes through.
RAKSHA_TRUSTED_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Media / uploads
# -----------------------------------------------------------------------------
RAKSHA_MEDIA_STORAGE_BACKEND=local      # local | s3 (s3 planned for Phase 18)
RAKSHA_MEDIA_STORAGE_PATH=./storage/media
RAKSHA_MEDIA_MAX_BYTES=10485760         # 10 MiB
RAKSHA_MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# Malware scanning via a ClamAV daemon (clamd). Unset: uploads are stored as
# UNSCANNED, which is recorded on the file and is not the same as clean.
# RAKSHA_CLAMAV_HOST=clamav
# RAKSHA_CLAMAV_PORT=3310
# RAKSHA_CLAMAV_TIMEOUT_SECONDS=10
# true: refuse uploads while the scanner is unreachable (default: keep, as UNSCANNED).
# RAKSHA_CLAMAV_REQUIRED=false

# -----------------------------------------------------------------------------
# Geospatial
# -----------------------------------------------------------------------------
RAKSHA_GEO_SRID=4326
RAKSHA_GEO_MAX_SEARCH_RADIUS_KM=50
# Rough bounding box used to reject obviously bogus coordinates (default: India).
RAKSHA_GEO_BBOX_MIN_LAT=6.0
RAKSHA_GEO_BBOX_MAX_LAT=37.5
RAKSHA_GEO_BBOX_MIN_LON=68.0
RAKSHA_GEO_BBOX_MAX_LON=97.5

# -----------------------------------------------------------------------------
# AI services (Phase 6+ — not used by V1)
# -----------------------------------------------------------------------------
RAKSHA_AI_ENABLED=false
# Photo observations (Phase 8): sends report photographs to Anthropic when an operator
# requests an analysis. Decide that first (docs/AI_ARCHITECTURE.md section 11).
# RAKSHA_AI_PROVIDER=anthropic
# RAKSHA_AI_API_KEY=set_via_secret_manager_never_in_git
# RAKSHA_AI_MODEL=            (unset = claude-opus-5-5)
# RAKSHA_AI_TIMEOUT_SECONDS=20
# Voice reports (Phase 9): sends a citizen's recording to the speech provider when they
# press record. Needs RAKSHA_AI_ENABLED=true as well. Decide that first
# (docs/AI_ARCHITECTURE.md section 11). The recording is never stored; the transcript is.
# RAKSHA_SPEECH_PROVIDER=openai
# RAKSHA_SPEECH_API_KEY=set_via_secret_manager_never_in_git
# RAKSHA_SPEECH_MODEL=        (unset = whisper-1; must return segment detail)
# RAKSHA_SPEECH_BASE_URL=     (unset = OpenAI; set an https:// OpenAI-compatible service instead)
# RAKSHA_SPEECH_TIMEOUT_SECONDS=30
# RAKSHA_SPEECH_MAX_BYTES=8388608
# RAKSHA_RATE_LIMIT_TRANSCRIPTION_PER_MINUTE=6

# -----------------------------------------------------------------------------
# Frontend (Next.js — these are build-time public values)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=13.0827
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LON=80.2707
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=11

# -----------------------------------------------------------------------------
# Overload protection and the database pool (see docs/PERFORMANCE.md)
# -----------------------------------------------------------------------------
# Connections per API process = POOL_SIZE + MAX_OVERFLOW. Keep processes x that
# under PostgreSQL max_connections (default 100).
# RAKSHA_DB_POOL_SIZE=10
# RAKSHA_DB_MAX_OVERFLOW=20
# Seconds a request waits for a connection before a 503 (not a 30 s hang).
# RAKSHA_DB_POOL_TIMEOUT=5
# Requests worked on at once per process. MUST stay below the pool total and the
# 40-thread worker pool, or overload deadlocks. Excess queues, then gets a 503.
# RAKSHA_MAX_CONCURRENT_REQUESTS=24
# RAKSHA_MAX_CONCURRENT_WAIT_SECONDS=3

# -----------------------------------------------------------------------------
# Email (password recovery and security notices) - docs/DEPLOYMENT.md section 12
# -----------------------------------------------------------------------------
# Unset RAKSHA_SMTP_HOST: there is no email channel. The platform works fully; the
# sign-in screens say self-service recovery is unavailable (ask an administrator).
# RAKSHA_SMTP_HOST=smtp.example.org
# RAKSHA_SMTP_PORT=587
# RAKSHA_SMTP_USERNAME=
# RAKSHA_SMTP_PASSWORD=
# starttls (port 587), ssl (port 465), or none (a local dev mailbox only; refused in
# staging/production):
# RAKSHA_SMTP_SECURITY=starttls
# RAKSHA_EMAIL_FROM="RAKSHA NET AI <no-reply@your-domain.example>"
# Where recovery links point. Fixed by configuration, never taken from the request.
# https:// is required in staging/production when email is on.
# RAKSHA_CITIZEN_APP_URL=http://localhost:3000
# RAKSHA_CONTROL_CENTER_URL=http://localhost:3001
# RAKSHA_RESPONDER_APP_URL=http://localhost:3002
# RAKSHA_PASSWORD_RESET_TOKEN_MINUTES=30
# RAKSHA_PASSWORD_RESET_MAX_PER_HOUR=3

# -----------------------------------------------------------------------------
# Observability and backups (see docs/DEPLOYMENT.md, infrastructure/deployment/RUNBOOK.md)
# -----------------------------------------------------------------------------
# Bearer token a metrics scraper must present to read /metrics. Unset: the
# endpoint does not exist (404). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# RAKSHA_METRICS_TOKEN=

# scripts/backup.sh encrypts to this age PUBLIC key when set (the private key,
# BACKUP_AGE_IDENTITY, is used only by restore.sh and must live elsewhere).
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY=/secure/age-private-key.txt
# BACKUP_DIR=./backups
